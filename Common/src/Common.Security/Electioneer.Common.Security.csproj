<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Electioneer.Common.Security</PackageId>
    <Version>0.1.0</Version>
    <Authors>Electioneer Team</Authors>
    <Description>
      Election-grade cryptographic primitives: receipt signing (Ed25519), ballot hashing (SHA-3-512),
      and pluggable key providers (Azure Key Vault, Hashicorp Vault, file, HSM).
      Designed for verifiability, non-repudiation, and post-election audits.
    </Description>
    <PackageTags>election voting cryptography ed25519 sha3 security audit receipt</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
    <PackageReference Include="Azure.Security.KeyVault.Keys" Version="4.8.0" />
    <PackageReference Include="NSec.Cryptography" Version="25.4.0" />
  </ItemGroup>

</Project>
